#!/bin/bash
# ===========================================================
# commit-msg hook — 验证 commit message 格式
# ===========================================================
# 安装: cp hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# ===========================================================

COMMIT_MSG_FILE=$1
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ===== Conventional Commits 规范 =====
# 格式: <type>(<scope>): <description>
# type 必须是以下之一:
#   feat     — 新功能
#   fix      — Bug 修复
#   chore    — 杂务（构建、依赖等）
#   refactor — 重构（不改功能不修 bug）
#   docs     — 文档
#   test     — 测试
#   style    — 代码格式（不影响逻辑）
#   perf     — 性能优化
#   ci       — CI/CD 配置
#   build    — 构建系统
#   revert   — 撤销提交

PATTERN="^(feat|fix|chore|refactor|docs|test|style|perf|ci|build|revert)(\(.+\))?: .{1,100}$"

# 允许 merge commit
MERGE_PATTERN="^Merge "

# 允许 revert
REVERT_PATTERN="^Revert \""

if echo "$FIRST_LINE" | grep -qE "$MERGE_PATTERN"; then
  exit 0
fi

if echo "$FIRST_LINE" | grep -qE "$REVERT_PATTERN"; then
  exit 0
fi

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo -e "${RED}╔══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  Commit message 不符合 Conventional Commits 规范       ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "  格式: ${YELLOW}<type>(<scope>): <description>${NC}"
  echo ""
  echo "  允许的 type:"
  echo "    feat     — 新功能"
  echo "    fix      — Bug 修复"
  echo "    chore    — 杂务"
  echo "    refactor — 重构"
  echo "    docs     — 文档"
  echo "    test     — 测试"
  echo "    style    — 格式"
  echo "    perf     — 性能"
  echo "    ci       — CI/CD"
  echo "    build    — 构建"
  echo "    revert   — 撤销"
  echo ""
  echo "  示例:"
  echo -e "    ${GREEN}feat(auth): 添加 OAuth2 登录支持${NC}"
  echo -e "    ${GREEN}fix: 修复用户列表分页问题${NC}"
  echo -e "    ${GREEN}chore(deps): 更新 lodash 到 4.17.21${NC}"
  echo ""
  echo -e "  你的消息: ${YELLOW}$FIRST_LINE${NC}"
  echo ""
  echo -e "  跳过检查: ${YELLOW}git commit --no-verify${NC}"
  echo ""
  exit 1
fi

# 检查 description 长度
DESC_LENGTH=${#FIRST_LINE}
if [ $DESC_LENGTH -gt 100 ]; then
  echo -e "${YELLOW}⚠️  Commit message 第一行过长 ($DESC_LENGTH > 100 字符)${NC}"
  echo "  建议: 第一行简短概述，详细说明放在空行后的 body 中"
fi

exit 0
