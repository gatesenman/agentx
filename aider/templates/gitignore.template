# =============================================================================
# .gitignore 模板 — 防止提交敏感文件和临时文件
# =============================================================================

# --- 密钥和凭据（永不提交） ---
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
id_rsa
id_ed25519
.secrets

# --- IDE 本地配置（不提交） ---
CLAUDE.local.md

# --- 依赖目录 ---
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/

# --- 构建输出 ---
dist/
build/
out/
.next/
target/

# --- 系统文件 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- 日志 ---
*.log
npm-debug.log*
yarn-debug.log*

# --- 测试覆盖 ---
coverage/
.nyc_output/
htmlcov/
