#!/bin/bash
# ===========================================================
# pre-commit hook — 提交前自动检查
# ===========================================================
# 安装: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 或运行: scripts/install-hooks.sh
# ===========================================================

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}▶ Running pre-commit checks...${NC}"
echo ""

# ===== 1. 密钥泄露检测 =====
echo -n "  [1/5] 密钥泄露检测..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo -e " ${GREEN}SKIP (no files)${NC}"
else
  # 检测常见密钥模式
  SECRETS_PATTERN='(AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{48}|ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{82}|xox[baprs]-[a-zA-Z0-9-]+|sk_live_[a-zA-Z0-9]+|pk_live_[a-zA-Z0-9]+|eyJ[a-zA-Z0-9]{30,}\.eyJ|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY)'

  SECRETS_FOUND=""
  for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
      MATCH=$(grep -nE "$SECRETS_PATTERN" "$file" 2>/dev/null || true)
      if [ -n "$MATCH" ]; then
        SECRETS_FOUND="$SECRETS_FOUND\n  $file:\n$MATCH\n"
      fi
    fi
  done

  if [ -n "$SECRETS_FOUND" ]; then
    echo -e " ${RED}FAIL${NC}"
    echo -e "${RED}╔══════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  ⚠️  可能的密钥泄露检测到!              ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════╝${NC}"
    echo -e "$SECRETS_FOUND"
    echo ""
    echo -e "如果是误报: ${YELLOW}git commit --no-verify${NC}"
    echo -e "如果是真实密钥: 立即移除并轮换密钥"
    exit 1
  fi
  echo -e " ${GREEN}PASS${NC}"
fi

# ===== 2. 禁止提交的文件检测 =====
echo -n "  [2/5] 禁止文件检测..."

FORBIDDEN_FILES=".env .env.local .env.production credentials.json service-account.json id_rsa id_ed25519"
FOUND_FORBIDDEN=""

for file in $STAGED_FILES; do
  BASENAME=$(basename "$file")
  for forbidden in $FORBIDDEN_FILES; do
    if [ "$BASENAME" = "$forbidden" ]; then
      FOUND_FORBIDDEN="$FOUND_FORBIDDEN $file"
    fi
  done
done

if [ -n "$FOUND_FORBIDDEN" ]; then
  echo -e " ${RED}FAIL${NC}"
  echo -e "${RED}  禁止提交的文件:${NC}"
  for f in $FOUND_FORBIDDEN; do
    echo "    - $f"
  done
  echo -e "  添加到 .gitignore 或使用 ${YELLOW}git commit --no-verify${NC}"
  exit 1
fi
echo -e " ${GREEN}PASS${NC}"

# ===== 3. 大文件检测 =====
echo -n "  [3/5] 大文件检测 (>5MB)..."

LARGE_FILES=""
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    SIZE=$(wc -c < "$file" 2>/dev/null || echo "0")
    if [ "$SIZE" -gt 5242880 ]; then
      SIZE_MB=$(echo "scale=1; $SIZE/1048576" | bc 2>/dev/null || echo "?")
      LARGE_FILES="$LARGE_FILES\n    $file (${SIZE_MB}MB)"
    fi
  fi
done

if [ -n "$LARGE_FILES" ]; then
  echo -e " ${YELLOW}WARN${NC}"
  echo -e "${YELLOW}  大文件警告:${NC}$LARGE_FILES"
  echo -e "  考虑使用 Git LFS 或 .gitignore"
else
  echo -e " ${GREEN}PASS${NC}"
fi

# ===== 4. Lint 检查 (仅对 staged 文件) =====
echo -n "  [4/5] Lint 检查..."

STAGED_TS=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
STAGED_RS=$(echo "$STAGED_FILES" | grep -E '\.rs$' || true)

LINT_FAILED=0

# TypeScript/JavaScript
if [ -n "$STAGED_TS" ] && [ -f "package.json" ]; then
  if command -v npx &> /dev/null; then
    if npx eslint $STAGED_TS --quiet 2>/dev/null; then
      :
    else
      LINT_FAILED=1
    fi
  fi
fi

# Python
if [ -n "$STAGED_PY" ]; then
  if command -v ruff &> /dev/null; then
    if ! ruff check $STAGED_PY 2>/dev/null; then
      LINT_FAILED=1
    fi
  elif command -v flake8 &> /dev/null; then
    if ! flake8 $STAGED_PY 2>/dev/null; then
      LINT_FAILED=1
    fi
  fi
fi

# Rust
if [ -n "$STAGED_RS" ] && [ -f "Cargo.toml" ]; then
  if command -v cargo &> /dev/null; then
    if ! cargo clippy --quiet 2>/dev/null; then
      LINT_FAILED=1
    fi
  fi
fi

if [ $LINT_FAILED -eq 1 ]; then
  echo -e " ${RED}FAIL${NC}"
  echo -e "  运行以下命令修复:"
  [ -n "$STAGED_TS" ] && echo "    npx eslint --fix $STAGED_TS"
  [ -n "$STAGED_PY" ] && echo "    ruff check --fix $STAGED_PY"
  [ -n "$STAGED_RS" ] && echo "    cargo clippy --fix"
  exit 1
fi
echo -e " ${GREEN}PASS${NC}"

# ===== 5. 类型检查 (可选，较慢) =====
echo -n "  [5/5] 类型检查..."

if [ -f "tsconfig.json" ] && [ -n "$STAGED_TS" ]; then
  if command -v npx &> /dev/null; then
    if ! npx tsc --noEmit --incremental 2>/dev/null; then
      echo -e " ${RED}FAIL${NC}"
      echo "  运行 'npx tsc --noEmit' 查看详细错误"
      exit 1
    fi
  fi
fi

if [ -n "$STAGED_PY" ]; then
  if command -v mypy &> /dev/null; then
    if ! mypy $STAGED_PY --ignore-missing-imports 2>/dev/null; then
      echo -e " ${YELLOW}WARN (mypy issues)${NC}"
    else
      echo -e " ${GREEN}PASS${NC}"
    fi
  else
    echo -e " ${GREEN}SKIP (no checker)${NC}"
  fi
else
  echo -e " ${GREEN}PASS${NC}"
fi

# ===== 完成 =====
echo ""
echo -e "${GREEN}✅ All pre-commit checks passed${NC}"
echo ""
