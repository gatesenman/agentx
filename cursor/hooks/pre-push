#!/bin/bash
# ===========================================================
# pre-push hook — 推送前检查
# ===========================================================
# 安装: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# ===========================================================

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo -e "${YELLOW}▶ Running pre-push checks on branch: $BRANCH${NC}"
echo ""

# ===== 1. 禁止直接推送到 main/master =====
echo -n "  [1/4] 分支保护检查..."

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo -e " ${RED}BLOCKED${NC}"
  echo ""
  echo -e "${RED}╔══════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  ⛔ 不允许直接推送到 $BRANCH                            ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo "  正确流程:"
  echo "    1. git checkout -b feat/my-feature"
  echo "    2. git push origin feat/my-feature"
  echo "    3. 创建 Pull Request"
  echo ""
  echo -e "  如果确实需要: ${YELLOW}git push --no-verify${NC} (不推荐)"
  exit 1
fi
echo -e " ${GREEN}PASS${NC}"

# ===== 2. 检查未提交的更改 =====
echo -n "  [2/4] 工作区状态..."

if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
  echo -e " ${YELLOW}WARN${NC}"
  echo -e "  ${YELLOW}有未提交的更改。确认这是预期的。${NC}"
else
  echo -e " ${GREEN}PASS${NC}"
fi

# ===== 3. 运行快速测试 =====
echo -n "  [3/4] 快速测试..."

TEST_PASSED=0

if [ -f "package.json" ]; then
  # 检查是否有 test script
  if grep -q '"test"' package.json 2>/dev/null; then
    if npm test -- --bail --watchAll=false --passWithNoTests 2>/dev/null; then
      TEST_PASSED=1
    else
      echo -e " ${RED}FAIL${NC}"
      echo ""
      echo -e "  ${RED}测试失败，推送已阻止${NC}"
      echo "  运行 'npm test' 查看详细信息"
      echo -e "  跳过: ${YELLOW}git push --no-verify${NC}"
      exit 1
    fi
  else
    TEST_PASSED=1
  fi
elif [ -f "pyproject.toml" ] || [ -f "setup.py" ] || [ -f "pytest.ini" ]; then
  if command -v pytest &> /dev/null; then
    if pytest tests/ --tb=short -q --timeout=60 2>/dev/null; then
      TEST_PASSED=1
    else
      echo -e " ${RED}FAIL${NC}"
      echo "  运行 'pytest tests/ -v' 查看详细信息"
      exit 1
    fi
  else
    TEST_PASSED=1
  fi
elif [ -f "Cargo.toml" ]; then
  if cargo test --quiet 2>/dev/null; then
    TEST_PASSED=1
  else
    echo -e " ${RED}FAIL${NC}"
    echo "  运行 'cargo test' 查看详细信息"
    exit 1
  fi
else
  TEST_PASSED=1
fi

if [ $TEST_PASSED -eq 1 ]; then
  echo -e " ${GREEN}PASS${NC}"
fi

# ===== 4. 构建检查 =====
echo -n "  [4/4] 构建检查..."

if [ -f "package.json" ]; then
  if grep -q '"build"' package.json 2>/dev/null; then
    if npm run build 2>/dev/null; then
      echo -e " ${GREEN}PASS${NC}"
    else
      echo -e " ${YELLOW}WARN (build issues)${NC}"
    fi
  else
    echo -e " ${GREEN}SKIP${NC}"
  fi
elif [ -f "Cargo.toml" ]; then
  if cargo build --quiet 2>/dev/null; then
    echo -e " ${GREEN}PASS${NC}"
  else
    echo -e " ${YELLOW}WARN${NC}"
  fi
else
  echo -e " ${GREEN}SKIP${NC}"
fi

# ===== 完成 =====
echo ""
echo -e "${GREEN}✅ Pre-push checks passed. Pushing to origin/$BRANCH...${NC}"
echo ""
