#!/usr/bin/env bash
# ============================================================================
# AgentX CLI — AI 智能体配置管理工具
# 版本: 1.0.0
# 项目: https://github.com/gaosichun888/agentx
# 描述: 一键安装、管理 13 个 IDE 的 AI 智能体规则配置
# ============================================================================

set -euo pipefail

# ---- 版本与全局变量 ----
readonly VERSION="1.0.0"
readonly PROGRAM_NAME="agentx"
readonly REPO_URL="https://github.com/gaosichun888/agentx"
readonly REPO_RAW_URL="https://raw.githubusercontent.com/gaosichun888/agentx/main"

# 缓存目录（存放下载的配置源）
CACHE_DIR="${AGENTX_CACHE_DIR:-${HOME}/.agentx}"
SOURCE_DIR=""  # 配置源目录，运行时确定

# ---- 支持的 IDE 列表 ----
declare -A IDE_NAMES=(
  [claude-code]="Claude Code (Anthropic)"
  [cursor]="Cursor IDE"
  [windsurf]="Windsurf IDE"
  [copilot]="GitHub Copilot / Copilot Chat"
  [codex]="OpenAI Codex CLI"
  [cline]="Cline (VS Code)"
  [codebuddy]="CodeBuddy (腾讯)"
  [augment]="Augment Code"
  [aider]="Aider"
  [roo-code]="Roo Code"
  [amazon-q]="Amazon Q Developer"
  [qodo]="Qodo (原 CodiumAI)"
  [devin]="Devin (Cognition AI)"
)

# IDE 排序列表
IDE_LIST=(claude-code cursor windsurf copilot codex cline codebuddy augment aider roo-code amazon-q qodo devin)

# ---- 颜色输出 ----
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  BLUE='\033[0;34m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  DIM='\033[2m'
  NC='\033[0m'
else
  RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' NC=''
fi

# ---- 日志函数 ----
info()    { echo -e "${GREEN}[✓]${NC} $*"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*"; }
error()   { echo -e "${RED}[✗]${NC} $*" >&2; }
step()    { echo -e "${BLUE}[→]${NC} $*"; }
header()  { echo -e "\n${BOLD}${CYAN}$*${NC}\n"; }

# ---- 工具函数 ----

# 检查命令是否存在
has_cmd() { command -v "$1" &>/dev/null; }

# 获取配置源目录
resolve_source_dir() {
  # 1. 环境变量指定
  if [[ -n "${AGENTX_SOURCE:-}" ]] && [[ -d "$AGENTX_SOURCE" ]]; then
    SOURCE_DIR="$AGENTX_SOURCE"
    return 0
  fi

  # 2. 脚本自身所在的仓库
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local repo_root="${script_dir%/cli}"
  if [[ -d "$repo_root/claude-code" ]] && [[ -d "$repo_root/cursor" ]]; then
    SOURCE_DIR="$repo_root"
    return 0
  fi

  # 3. 缓存目录
  if [[ -d "$CACHE_DIR/repo/claude-code" ]]; then
    SOURCE_DIR="$CACHE_DIR/repo"
    return 0
  fi

  # 4. 需要下载
  return 1
}

# 确保配置源可用
ensure_source() {
  if resolve_source_dir; then
    return 0
  fi

  step "首次使用，正在下载 AgentX 配置源..."

  if ! has_cmd git; then
    error "需要安装 git。请先安装: https://git-scm.com/"
    exit 1
  fi

  mkdir -p "$CACHE_DIR"
  git clone --depth 1 "$REPO_URL.git" "$CACHE_DIR/repo" 2>/dev/null || {
    error "下载失败。请检查网络连接。"
    exit 1
  }

  SOURCE_DIR="$CACHE_DIR/repo"
  info "配置源已下载到 $CACHE_DIR/repo"
}

# 验证 IDE 名称
validate_ide() {
  local ide="$1"
  if [[ -z "${IDE_NAMES[$ide]+_}" ]]; then
    error "不支持的 IDE: $ide"
    echo ""
    echo "支持的 IDE:"
    for id in "${IDE_LIST[@]}"; do
      echo "  $id  →  ${IDE_NAMES[$id]}"
    done
    exit 1
  fi
}

# 获取目标目录
get_target_dir() {
  local target="${1:-.}"
  if [[ ! -d "$target" ]]; then
    error "目标目录不存在: $target"
    exit 1
  fi
  echo "$(cd "$target" && pwd)"
}

# 复制文件（保留目录结构）
copy_with_structure() {
  local src="$1"
  local dst="$2"
  local base="$3"

  local rel_path="${src#$base/}"
  local dst_path="$dst/$rel_path"
  local dst_dir
  dst_dir="$(dirname "$dst_path")"

  mkdir -p "$dst_dir"
  cp "$src" "$dst_path"
}

# ---- 主命令实现 ----

